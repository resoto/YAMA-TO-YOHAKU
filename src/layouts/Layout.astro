---
import '../styles/global.css';
import Mark from '../components/Mark.astro';
import { site } from '../config';
interface Props { title?: string; description?: string; noindex?: boolean }
const { title, description = site.description, noindex = false } = Astro.props;
const pageTitle = title ? `${title} | ${site.name}` : `${site.name} 山歩きと、暮らしの記録`;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
const path = Astro.url.pathname;
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#193f35" />
    {noindex && <meta name="robots" content="noindex" />}
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ja_JP" />
    <meta property="og:site_name" content={site.name} />
    {canonical && <meta property="og:url" content={canonical} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">本文へ移動</a>
    <header class="site-header shell">
      <a class="brand" href="/" aria-label={`${site.name} ホーム`}><Mark /><span><strong>{site.name}</strong><small>{site.englishName}</small></span></a>
      <nav class="desktop-nav" aria-label="メインナビゲーション">
        <a href="/" aria-current={path === '/' ? 'page' : undefined}>ホーム</a>
        <a href="/category/hiking/" aria-current={path === '/category/hiking/' ? 'page' : undefined}>山の記録</a>
        <a href="/category/gear/" aria-current={path === '/category/gear/' ? 'page' : undefined}>道具と支度</a>
        <a href="/about/" aria-current={path === '/about/' ? 'page' : undefined}>このブログについて</a>
      </nav>
      <a class="header-note" href="/blog/">A LITTLE CLOSER TO NATURE <span>山のある日々を。</span></a>
      <details class="mobile-menu"><summary aria-label="ナビゲーションを開く"><span></span><span></span><span class="sr-only">メニュー</span></summary><nav aria-label="モバイルナビゲーション"><a href="/">ホーム</a><a href="/blog/">すべての記事</a><a href="/category/hiking/">山の記録</a><a href="/category/gear/">道具と支度</a><a href="/category/essay/">山のひとこま</a><a href="/about/">このブログについて</a></nav></details>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer">
      <div class="shell footer-top"><a class="brand" href="/"><Mark /><span><strong>{site.name}</strong><small>{site.englishName}</small></span></a><p>山を歩く。深呼吸する。<br />日常に、小さな余白を。</p><nav aria-label="フッターナビゲーション"><a href="/blog/">記事を読む</a><a href="/about/">このブログについて</a><a href="/about/#photo-credits">写真について</a></nav></div>
      <div class="shell footer-bottom"><span>© {new Date().getFullYear()} {site.englishName}</span><span>TAKE A WALK. FIND YOUR SPACE.</span><a href="#main">ページの上へ</a></div>
    </footer>
  </body>
</html>
