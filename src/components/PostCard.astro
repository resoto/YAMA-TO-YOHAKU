---
import type { CollectionEntry } from 'astro:content';
import { categories, photos } from '../config';
import { formatDate } from '../lib/posts';
interface Props { post: CollectionEntry<'posts'>; index?: number }
const { post, index = 0 } = Astro.props;
const photo = photos[post.data.image];
const category = categories.find(c => c.id === post.data.category)!;
---
<article class="post-card">
  <a class="post-image-link" href={`/posts/${post.id}/`} tabindex="-1" aria-hidden="true">
    <img src={photo.src} alt="" width="900" height="640" loading="lazy" />
    <span class="image-number">{String(index + 1).padStart(2, '0')} / FIELD NOTES</span>
    <span class="location-label"><svg viewBox="0 0 20 20" aria-hidden="true"><path d="M10 18s6-6 6-11a6 6 0 0 0-12 0c0 5 6 11 6 11Z"/><circle cx="10" cy="7" r="2"/></svg>{post.data.location}</span>
  </a>
  <div class="post-meta"><span>{category.label}</span><time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time></div>
  <h3><a href={`/posts/${post.id}/`}>{post.data.title}</a></h3>
  <p>{post.data.description}</p>
  <div class="post-foot"><span>{post.data.readingTime} MIN READ</span>{post.data.sample && <span>サンプル記事</span>}</div>
</article>
