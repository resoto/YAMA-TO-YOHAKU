---
import PostCard from './PostCard.astro';
import { categories } from '../config';
import { getPosts } from '../lib/posts';
interface Props { selected?: string; limit?: number; home?: boolean }
const { selected, limit, home = false } = Astro.props;
const allPosts = await getPosts();
const posts = selected ? allPosts.filter(p => p.data.category === selected) : allPosts;
const shown = limit ? posts.slice(0, limit) : posts;
const Heading = home ? 'h2' : 'h1';
---
<section class="journal shell" id="journal" aria-labelledby="journal-heading">
  <div class="section-heading"><div><span class="eyebrow">THE JOURNAL</span><Heading id="journal-heading">{home ? '山からの、便り。' : selected ? categories.find(c => c.id === selected)?.label : 'すべての記録。'}</Heading></div><p>{home ? '歩いた道、出会った景色、使い続けたい道具。' : '山を楽しむための、小さな読みもの。'}</p>{home && <a class="text-link" href="/blog/">すべての記事を見る <span class="link-plus" aria-hidden="true">＋</span></a>}</div>
  <nav class="category-nav" aria-label="記事のカテゴリー"><a href={home ? '/#journal' : '/blog/'} class:list={{ active: !selected }} aria-current={!selected ? 'page' : undefined}>すべて<span>{String(allPosts.length).padStart(2, '0')}</span></a>{categories.map(c => <a href={`/category/${c.id}/`} class:list={{ active: selected === c.id }} aria-current={selected === c.id ? 'page' : undefined}>{c.label}<span>{String(allPosts.filter(p => p.data.category === c.id).length).padStart(2, '0')}</span></a>)}</nav>
  <div class="post-grid">{shown.map((post, index) => <PostCard post={post} index={index} />)}</div>
  {shown.length === 0 && <p class="empty-state">このカテゴリーの記事は、ただいま準備中です。<a href="/blog/">すべての記事を読む</a></p>}
</section>
