---
import Layout from '../../layouts/Layout.astro';
import PostList from '../../components/PostList.astro';
import { categories } from '../../config';
export function getStaticPaths() { return categories.map(category => ({ params: { category: category.id }, props: { category } })); }
const { category } = Astro.props;
---
<Layout title={category.label}><div class="shell breadcrumb"><a href="/">ホーム</a><span>/</span><span>{category.label}</span></div><PostList selected={category.id} /></Layout>
