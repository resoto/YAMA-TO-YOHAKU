---
import { render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import PostCard from '../../components/PostCard.astro';
import { categories, photos } from '../../config';
import { getPosts, formatDate } from '../../lib/posts';
export async function getStaticPaths() { return (await getPosts()).map(post => ({ params: { id: post.id }, props: { post } })); }
const { post } = Astro.props;
const { Content, headings } = await render(post);
const photo = photos[post.data.image];
const category = categories.find(c => c.id === post.data.category)!;
const related = (await getPosts()).filter(p => p.id !== post.id).slice(0, 2);
---
<Layout title={post.data.title} description={post.data.description}>
  <div class="shell breadcrumb"><a href="/">ホーム</a><span>/</span><a href={`/category/${category.id}/`}>{category.label}</a><span>/</span><span>記事</span></div>
  <article class="article shell">
    <header class="article-header"><span class="eyebrow">{category.english}</span><h1>{post.data.title}</h1><p>{post.data.description}</p><div class="article-meta"><time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time><span>{post.data.readingTime} MIN READ</span><span>{post.data.location}</span></div></header>
    <figure class="article-cover"><img src={photo.src} alt={photo.alt} width="1600" height="900" fetchpriority="high" /><figcaption>{photo.location} — 写真：<a href={photo.source}>Raita Futo</a> / <a href="https://creativecommons.org/licenses/by/2.0/">CC BY 2.0</a>（トリミング・圧縮）</figcaption></figure>
    <div class="article-layout"><div class="article-body">{post.data.sample && <aside class="sample-note"><strong>サンプル記事</strong><p>この文章はブログの見本です。実際の山行記録ではありません。写真はイメージとして使用しています。</p></aside>}<Content /><div class="article-return"><a class="text-link" href="/blog/">記事一覧に戻る <span class="link-plus" aria-hidden="true">＋</span></a></div></div><aside class="article-sidebar"><div class="table-of-contents"><span class="eyebrow">IN THIS ARTICLE</span><h2>この記事の目次</h2><ol>{headings.filter(h => h.depth === 2).map(h => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol></div></aside></div>
  </article>
  <section class="shell related"><div class="section-heading"><div><span class="eyebrow">KEEP WANDERING</span><h2>次に読みたい、山のこと。</h2></div></div><div class="post-grid two-columns">{related.map((p, index) => <PostCard post={p} index={index} />)}</div></section>
</Layout>
